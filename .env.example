# Copied to .env by `make up` if .env does not exist. Local development only.
POSTGRES_USER=seatlock
POSTGRES_PASSWORD=seatlock
POSTGRES_DB=seatlock

# Host ports. Change them in .env if 8000 or 5432 are already in use.
API_PORT=8000
POSTGRES_PORT=5432

# Connections in the api's pool (fixed size).
DB_POOL_SIZE=10

# naive | pessimistic | optimistic | conditional | serializable
HOLD_STRATEGY=pessimistic
# How long a hold lasts before the seat is free again.
HOLD_SECONDS=300
# The background sweeper resets expired holds this often (0 = off).
EXPIRY_SWEEP_SECONDS=5
