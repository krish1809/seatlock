# Copied to .env by `make up` if .env does not exist. Local development only.
POSTGRES_USER=seatlock
POSTGRES_PASSWORD=seatlock
POSTGRES_DB=seatlock

# Host ports. Change them in .env if 8000 or 5432 are already in use.
API_PORT=8000
POSTGRES_PORT=5432

# Connections in the api's pool (fixed size).
DB_POOL_SIZE=10
